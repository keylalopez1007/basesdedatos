# Servidor
PORT=3307
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL: complete estos valores en .env con los datos de su instancia local.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=animal_hospital_anomaly
MYSQL_CONNECTION_LIMIT=10

# Autenticación: use una cadena larga, aleatoria y privada en .env.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Frontend
FRONTEND_API_URL=http://localhost:3307/api
